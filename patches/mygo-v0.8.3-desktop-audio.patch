+							}
+							if i+1 < len(tracks) {
+								tracks[i+1].Play()
+							} else {
+								mu.Lock()
+								testMode = true
+								mu.Unlock()
+							}
+						}
+						return nil
+					}
+					playOutput()
+					if !completed || !d.closed {
